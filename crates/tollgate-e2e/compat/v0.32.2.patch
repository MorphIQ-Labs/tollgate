+fn setting(name: &str) -> std::io::Result<String> {
+    std::env::var(name).map_err(|error| std::io::Error::other(format!("{name}: {error}")))
+}
+
+fn number(name: &str) -> std::io::Result<u64> {
+    setting(name)?
+        .parse()
+        .map_err(|error| std::io::Error::other(format!("{name}: {error}")))
+}
+
+fn secret_file(name: &str) -> std::io::Result<String> {
+    Ok(std::fs::read_to_string(setting(name)?)?
+        .trim_end()
+        .to_owned())
+}
