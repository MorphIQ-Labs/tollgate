#!/usr/bin/env bash
# Reject a commit whose Rust is not rustfmt-clean.
#
# `cargo fmt --check` is the first thing CI runs (.gitlab-ci.yml, lint stage),
# and it fails the whole pipeline before clippy or tests get a chance — so a
# formatting slip costs a full round-trip. This catches it in under a second.
#
# Checks, never rewrites: silently reformatting files mid-commit would stage
# content the author never saw.
#
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass deliberately:    git commit --no-verify

set -euo pipefail

# Nothing staged under a Rust path? Nothing to check.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.rs$|(^|/)Cargo\.toml$'; then
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not on PATH; skipping fmt check" >&2
    exit 0
fi

if ! cargo fmt --check --quiet 2>/dev/null; then
    echo >&2
    echo "pre-commit: rustfmt would change these files —" >&2
    cargo fmt --check 2>&1 | grep -oE '^Diff in [^:]+' | sed 's/^Diff in /  /' | sort -u >&2
    echo >&2
    echo "  fix:    cargo fmt" >&2
    echo "  bypass: git commit --no-verify" >&2
    echo >&2
    exit 1
fi
